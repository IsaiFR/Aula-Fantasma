# Plantilla documental: la app NO lee archivos .env automáticamente.
# No se necesitan claves API, contraseñas ni tokens para ejecutar Aula Fantasma.
# Git ignora los archivos .env privados; no añadas secretos a esta plantilla.
# Para usar estas opciones, define variables de entorno antes del comando.
# Todas son opcionales; normalmente se dejan sin definir.

# Carpeta de cache con el ZIP de Electron, solo al empaquetar.
# PowerShell: $env:AULA_ELECTRON_ZIP_DIR='C:\ruta\cache-electron'
# AULA_ELECTRON_ZIP_DIR=

# Ejecutable alternativo de Electron, para pruebas sin --packaged.
# AULA_ELECTRON_EXE=

# Módulo de canvas para el generador opcional de EduPiramyd.
# AULA_CANVAS_MODULE=

# OBS usa su configuración local de AppData. No copies aquí su contraseña.
